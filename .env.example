PORT=3000
MONGO_URI=mongodb://localhost:27017/notification-service

# LocalStack SQS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566

# Queue names (created by scripts/createQueues.js)
EMAIL_QUEUE_NAME=email-queue
SMS_QUEUE_NAME=sms-queue
EMAIL_DLQ_NAME=email-dlq
SMS_DLQ_NAME=sms-dlq

# Redrive policy — after this many failed receives, message goes to DLQ
MAX_RECEIVE_COUNT=3
VISIBILITY_TIMEOUT_SECONDS=30

# Simulated failure rate for workers (0 to 1) — for local testing of retry/DLQ flow
SIMULATED_FAILURE_RATE=0.4